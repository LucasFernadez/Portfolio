---
import { projects } from "../data/site";

// Dominio legible para la barra del navegador simulado ("ribera9trainer.com").
const hostname = (link?: string) =>
  link ? new URL(link).hostname.replace(/^www\./, "") : undefined;
---

<section id="proyectos" class="border-t border-border/60">
  <div class="shell shell--full py-20 sm:py-24">
    <div class="mb-14 sm:mb-20" data-reveal>
      <div class="flex items-end justify-between gap-4">
        <div>
          <p class="label-caps mb-2 text-xs font-medium text-muted">Trabajo</p>
          <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
            Proyectos seleccionados
          </h2>
        </div>
        <div class="hidden h-px flex-1 bg-border sm:block"></div>
      </div>
      <p class="mt-4 max-w-2xl text-secondary">
        Una muestra de trabajos reales: webs para clientes, mantenimiento
        continuo y aplicaciones a medida.
      </p>
    </div>

    {
      projects.length > 0 ? (
        <div class="flex flex-col gap-20 sm:gap-28">
          {projects.map((p, i) => {
            const domain = hostname(p.link);
            const flip = i % 2 === 1;
            return (
              <article
                class:list={[
                  "proj-row grid items-center gap-8 lg:grid-cols-12 lg:gap-12",
                  flip && "proj-row--right",
                ]}
              >
                {/* Captura dentro de un navegador simulado */}
                <div
                  data-reveal
                  data-tilt
                  class:list={["lg:col-span-7", flip && "lg:order-2"]}
                >
                  <div class="group overflow-hidden rounded-xl border border-border bg-surface-2 shadow-2xl shadow-black/[0.10] ring-1 ring-inset ring-black/[0.03] transition-colors duration-300 hover:border-accent/60 dark:shadow-black/40 dark:ring-white/[0.03]">
                    <div class="flex h-10 items-center gap-3 border-b border-border bg-surface px-4">
                      <div class="flex gap-1.5" aria-hidden="true">
                        <span class="h-2.5 w-2.5 rounded-full bg-border" />
                        <span class="h-2.5 w-2.5 rounded-full bg-border" />
                        <span class="h-2.5 w-2.5 rounded-full bg-border" />
                      </div>
                      {domain && (
                        <span class="mx-auto truncate rounded-md border border-border bg-surface-2 px-3 py-0.5 font-mono text-[0.7rem] text-muted">
                          {domain}
                        </span>
                      )}
                    </div>
                    <div class="aspect-[16/10] overflow-hidden bg-gradient-to-br from-surface-2 to-bg">
                      {p.image ? (
                        <img
                          src={p.image}
                          alt={p.imageAlt ?? p.title}
                          loading="lazy"
                          decoding="async"
                          width="1440"
                          height="900"
                          class="h-full w-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-[1.03]"
                        />
                      ) : (
                        <div class="flex h-full items-center justify-center">
                          <span class="label-caps text-xs text-muted">
                            Vista previa
                          </span>
                        </div>
                      )}
                    </div>
                  </div>
                </div>

                {/* Ficha del proyecto */}
                <div
                  data-reveal-group
                  class:list={[
                    "proj-text lg:col-span-5",
                    flip && "lg:order-1",
                  ]}
                >
                  <div class="flex items-center gap-3" data-reveal>
                    <span class="font-mono text-sm font-medium text-accent">
                      {String(i + 1).padStart(2, "0")}
                    </span>
                    <span class="h-px w-8 bg-border" />
                    <span class="label-caps text-xs font-medium text-muted">
                      {p.category}
                    </span>
                  </div>

                  <h3
                    class="mt-4 text-2xl font-bold tracking-tight sm:text-3xl"
                    data-reveal
                  >
                    {p.title}
                  </h3>
                  <p class="mt-4 leading-relaxed text-secondary" data-reveal>
                    {p.description}
                  </p>

                  {p.highlights && p.highlights.length > 0 && (
                    <ul class="mt-6 space-y-2.5">
                      {p.highlights.map((h) => (
                        <li class="flex items-start gap-3 text-sm text-fg" data-reveal>
                          <svg
                            viewBox="0 0 24 24"
                            class="mt-0.5 h-4 w-4 flex-none text-accent"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.25"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                          >
                            <path d="M20 6 9 17l-5-5" />
                          </svg>
                          {h}
                        </li>
                      ))}
                    </ul>
                  )}

                  <div class="mt-6 flex flex-wrap gap-2" data-reveal>
                    {p.tags.map((t) => (
                      <span class="rounded border border-border bg-surface-2 px-2 py-1 font-mono text-xs text-muted">
                        {t}
                      </span>
                    ))}
                  </div>

                  {p.link && (
                    <a
                      href={p.link}
                      target="_blank"
                      rel="noopener noreferrer"
                      data-reveal
                      class="mt-8 inline-flex items-center gap-2 rounded-md border border-border bg-surface-2 px-5 py-2.5 text-sm font-medium text-fg transition-all hover:-translate-y-0.5 hover:border-accent/60 hover:text-accent"
                    >
                      Visitar web
                      <span aria-hidden="true">↗</span>
                      <span class="sr-only">(se abre en una pestaña nueva)</span>
                    </a>
                  )}
                </div>
              </article>
            );
          })}
        </div>
      ) : (
        <div class="indent rounded-xl border border-dashed border-border bg-surface/50 px-6 py-16 text-center">
          <p class="text-lg font-medium">Proyectos en camino</p>
          <p class="mx-auto mt-2 max-w-md text-sm text-secondary">
            Estoy preparando una selección de mis mejores trabajos. Mientras
            tanto, ¿hablamos de tu proyecto?
          </p>
          <a
            href="#contacto"
            class="mt-6 inline-flex items-center justify-center rounded-md border border-border bg-surface-2 px-5 py-2.5 text-sm font-medium text-secondary transition-all hover:-translate-y-0.5 hover:border-muted hover:bg-surface hover:text-fg"
          >
            Contáctame
          </a>
        </div>
      )
    }
  </div>
</section>

<style>
  /* Cascada: cada proyecto se pega a un margen y alterna lado, dejando el
     aire sobrante al otro lado. El primero a la izquierda (alineado con el
     titular), el segundo a la derecha, y así. */
  @media (min-width: 1024px) {
    .proj-row {
      width: min(100%, 1400px);
      margin-right: auto;
    }
    .proj-row--right {
      margin-right: 0;
      margin-left: auto;
    }

    /* El texto se estira hacia el margen que la cascada deja libre: se
       mueve solo él, la captura se queda donde está. El tirón se corta a
       cero cuando no sobra pantalla, para no provocar scroll lateral. */
    .proj-text {
      --pull: clamp(0px, calc((100vw - 1500px) / 2), 150px);
      max-width: none;
      margin-inline: 0 calc(var(--pull) * -1);
      padding-left: clamp(1.5rem, 2vw, 3rem);
    }
    .proj-row--right .proj-text {
      margin-inline: calc(var(--pull) * -1) 0;
      padding-left: 0;
      padding-right: clamp(1.5rem, 2vw, 3rem);
    }
  }

  /* Con el ancho holgado ya no hacen falta guiones para justificar */
  .proj-text p {
    text-align: justify;
  }
</style>
